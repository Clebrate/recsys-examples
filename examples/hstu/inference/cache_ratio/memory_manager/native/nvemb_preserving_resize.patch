@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+#ifdef __CUDACC__
+#define NVE_REHASH_HD __host__ __device__
+#else
+#define NVE_REHASH_HD
+#endif
+
+namespace nve {
+struct VmmRehashResult {
+  uint64_t occupied_rows = 0;
+  uint64_t survivor_rows = 0;
+  uint64_t evicted_rows = 0;
+};
+
+NVE_REHASH_HD inline bool vmm_rehash_valid_counter(uint32_t bits) {
+  const uint32_t magnitude = bits & 0x7fffffffU;
+  return magnitude < 0x7f800000U && (!(bits & 0x80000000U) || magnitude == 0);
+}
+
+// Match the existing raw planner's numeric ordering even when the SDK compiles
+// CUDA with --use_fast_math (which otherwise flushes subnormal float operands).
+// Positive IEEE representations sort numerically; +0 and -0 compare equal.
+// This does not change the native insertion kernel's way-based handling of ties.
+NVE_REHASH_HD inline bool vmm_rehash_better_bits(uint32_t a_bits, uint64_t a_key,
+                                                uint32_t b_bits, uint64_t b_key) {
+  const uint32_t a = a_bits & 0x7fffffffU, b = b_bits & 0x7fffffffU;
+  return a != b ? a > b : a_key < b_key;
+}
+
+inline int vmm_rehash_direction(uint64_t old_sets, uint64_t new_sets) {
+  if (!old_sets || !new_sets || old_sets > UINT32_MAX || new_sets > UINT32_MAX)
+    throw std::invalid_argument("unsupported_set_count");
+  if (new_sets == old_sets) return 0;
+  if (new_sets == old_sets * 2) return 1;
+  if (old_sets == new_sets * 2) return -1;
+  throw std::invalid_argument("vmm_resize_requires_half_or_double_sets");
+}
+}  // namespace nve
+#undef NVE_REHASH_HD
diff --git a/include/ecache/ec_vmm_storage.hpp b/include/ecache/ec_vmm_storage.hpp

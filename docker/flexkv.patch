+    @staticmethod
+    def _find_dim_by_size(
+        shape: torch.Size,
+        target: int,
+        exclude: Optional[set[int]] = None,
+    ) -> Optional[int]:
+        if exclude is None:
+            exclude = set()
+        for idx, size in enumerate(shape):
+            if idx in exclude:
+                continue
+            if int(size) == int(target):
+                return idx
+        return None
+
+    def _resolve_gpu_runtime_strides_in_bytes(
+        self,
+        sample_tensor: torch.Tensor,
+        gpu_kv_layout: KVCacheLayout,
+        gpu_block_type: int,
+        dtype: torch.dtype,
+        is_mla: bool,
+    ) -> Tuple[int, int, int]:
+        """
+        Resolve GPU strides from runtime tensor layout instead of assuming
+        KVCacheLayout-implied contiguous order.
+        """
+        itemsize = dtype.itemsize
+        shape = sample_tensor.shape
+        strides = sample_tensor.stride()
+
+        block_dim = self._find_dim_by_size(shape, int(gpu_kv_layout.num_block))
+        if block_dim is None:
+            block_dim = 0
+
+        layer_dim = self._find_dim_by_size(
+            shape,
+            int(gpu_kv_layout.num_layer),
+            exclude={block_dim},
+        )
+
+        kv_dim: Optional[int] = None
+        if not is_mla:
+            kv_dim = self._find_dim_by_size(
+                shape,
+                2,
+                exclude={block_dim} | ({layer_dim} if layer_dim is not None else set()),
+            )
+            if kv_dim is None and len(shape) >= 2:
+                kv_dim = 1 if block_dim == 0 else 0
+            if kv_dim == block_dim:
+                kv_dim = None
+
+        block_stride = int(strides[block_dim])
+        kv_stride = int(strides[kv_dim]) if kv_dim is not None else 0
+
+        # Layer stride is meaningful when all layers are packed in one tensor (TRTLLM style).
+        if gpu_block_type == 1 and layer_dim is not None:
+            layer_stride = int(strides[layer_dim])
+        else:
+            layer_stride = int(gpu_kv_layout.get_layer_stride())
+
+        return (
+            kv_stride * itemsize,
+            block_stride * itemsize,
+            layer_stride * itemsize,
+        )
+

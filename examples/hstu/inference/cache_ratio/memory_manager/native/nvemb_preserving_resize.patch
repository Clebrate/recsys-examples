+template <typename KeyType>
+std::string GpuTable<KeyType>::resize_cache_preserving(
+    size_t payload_bytes, uint64_t generation, size_t pool_limit, size_t host_limit, bool dry_run) {
+  if constexpr (!std::is_same_v<KeyType, int64_t>) {
+    throw std::invalid_argument("Preserving resize supports int64 keys only");
+  } else {
+  using DeviceCache = nve::CacheSADeviceModify<KeyType, KeyType>;
+  using Raw = typename DeviceCache::RawState;
+  ScopedDevice scope(config_.device_id);
+  if (vmm_storage_) vmm_storage_->validate_context();
+  auto before = nlohmann::json::parse(cache_resize_state());
+  nlohmann::json receipt = {{"status", "rejected"}, {"before", before},
+                           {"requested_payload_bytes", payload_bytes}, {"extra_peak_bytes", 0},
+                           {"host_staging_limit_bytes", host_limit}};
+  const auto reject = [&](const std::string& why) {
+    receipt["reason"] = why;
+    receipt["after"] = before;
+    return receipt.dump();
+  };
+  if (resize_poisoned_ || !cache_) return reject("poisoned");
+  if (generation != resize_generation_) return reject("stale_generation");
+  if (!dry_run && !contexts_->empty()) return reject("execution_contexts_are_still_live");
+  auto source = std::dynamic_pointer_cast<DeviceCache>(cache_);
+  const size_t row = static_cast<size_t>(config_.row_size_in_bytes);
+  constexpr size_t ways = DeviceCache::NUM_WAYS;
+  const size_t sets = payload_bytes / (ways * row);
+  if (!sets || sets > UINT32_MAX) return reject("target_must_hold_one_native_set");
+  const auto before_sets = before.at("num_sets").template get<size_t>();
+  const size_t per_set = ((row * ways + 15) / 16) * 16 + ways * sizeof(KeyType) +
+                         ways * sizeof(float) + sizeof(int64_t);
+  if (sets > std::numeric_limits<size_t>::max() / per_set) return reject("geometry_overflow");
+  size_t target_pool = sets * per_set;
+  if (vmm_storage_) {
+    if (sets > vmm_storage_->max_sets()) return reject("vmm_maximum_payload");
+    target_pool = vmm_storage_->mapped_bytes_for_payload(sets * ways * row) + vmm_storage_->fixed_device_bytes();
+  }
+  target_pool += policy_observation_ ? policy_observation_->bytes() : 0;
+  if (target_pool > pool_limit) return reject("device_pool_budget");
+  receipt["payload_bytes"] = sets * ways * row;
+  receipt["device_pool_bytes"] = target_pool;
+  receipt["generation"] = resize_generation_;
+  receipt["preserves_survivors"] = true;
+  receipt["preserves_counter_bits_and_ages"] = true;
+  receipt["physical_mode"] = vmm_storage_ ? "vmm_values_original_raw_rehash" : "cpu_staging_release_then_allocate";
+  receipt["vmm"] = bool(vmm_storage_);
+  if (sets == before_sets) {
+    receipt["status"] = dry_run ? "planned" : "unchanged";
+    receipt["after"] = before;
+    receipt["survivor_rows"] = nullptr;
+    receipt["evicted_rows"] = 0;
+    return receipt.dump();
+  }
+  if (vmm_storage_ && vmm_general_rehash_) {
+    const size_t host_bound = general_host_bound<Raw>(before_sets, sets, row);
+    if (host_bound > host_limit) return reject("host_staging_budget");
+    const auto preflight_start = std::chrono::steady_clock::now();
+    Raw old;
+    GeneralRehashPlan<Raw> plan;
+    try {
+      old = source->export_general_state(true, host_limit);
+      plan = plan_general_rehash(old, sets, host_limit);
+    }
+    catch (const std::invalid_argument& error) { return reject(error.what()); }
+    catch (...) { resize_poisoned_ = true; throw; }
+    receipt["native_preflight_ms"] = nvemb_elapsed_ms(preflight_start);
+    receipt["physical_mode"] = "vmm_native_general_row_ages_cpu_staging";
+    receipt["age_granularity"] = "row";
+    receipt["survivor_rows"] = plan.survivor_rows;
+    receipt["evicted_rows"] = plan.evicted_keys.size();
+    receipt["host_staging_peak_bound_bytes"] = plan.host_peak_bound;
+    receipt["status"] = "planned";
+    if (dry_run) return receipt.dump();
+    old = Raw{};
+    resize_poisoned_ = true;
+    double mapping_ms = 0;
+    if (sets > before_sets) {
+      const auto start = std::chrono::steady_clock::now();
+      vmm_storage_->resize_values(sets * ways * row);
+      mapping_ms += nvemb_elapsed_ms(start);
+    }
+    const auto rewrite_start = std::chrono::steady_clock::now();
+    source->apply_general_state(plan.target, true, host_limit);
+    if (policy_observation_) policy_observation_->append_capacity(plan.evicted_keys, plan.target.global_ts);
+    receipt["native_rehash_ms"] = nvemb_elapsed_ms(rewrite_start);
+    if (sets < before_sets) {
+      const auto start = std::chrono::steady_clock::now();
+      vmm_storage_->resize_values(sets * ways * row);
+      mapping_ms += nvemb_elapsed_ms(start);
+    }
+    receipt["vmm_mapping_ms"] = mapping_ms;
+    config_.cache_size = sets * per_set;
+    ++resize_generation_; resize_poisoned_ = false;
+    receipt["status"] = "applied"; receipt["after"] = nlohmann::json::parse(cache_resize_state());
+    return receipt.dump();
+  }
+  if (vmm_storage_ && vmm_fast_rehash_) {
+    if (!(sets == 2 * before_sets || before_sets == 2 * sets))
+      return reject("vmm_factor2_geometry_required");
+    const auto preflight_start = std::chrono::steady_clock::now();
+    typename DeviceCache::VmmRehashResult migration;
+    try {
+      migration = source->plan_vmm_factor2(sets, true);
+    } catch (const std::invalid_argument& error) {
+      return reject(error.what());
+    } catch (...) {
+      // A CUDA/preflight execution failure also poisons the native view.
+      // Reflect that state here so bindings never rebuild serving contexts.
+      resize_poisoned_ = true;
+      throw;
+    }
+    receipt["native_preflight_ms"] = nvemb_elapsed_ms(preflight_start);
+    receipt["physical_mode"] = "vmm_values_original_modulo_factor2_rehash";
+    receipt["survivor_rows"] = migration.survivor_rows;
+    receipt["evicted_rows"] = migration.evicted_rows;
+    receipt["host_staging_peak_bound_bytes"] = 0;
+    receipt["status"] = "planned";
+    if (dry_run) return receipt.dump();
+    resize_poisoned_ = true;
+    double mapping_ms = 0;
+    if (sets > before_sets) {
+      const auto mapping_start = std::chrono::steady_clock::now();
+      vmm_storage_->resize_values(sets * ways * row);
+      mapping_ms += nvemb_elapsed_ms(mapping_start);
+    }
+    const auto rehash_start = std::chrono::steady_clock::now();
+    const auto migrated = source->apply_vmm_factor2(sets, true);
+    receipt["native_rehash_ms"] = nvemb_elapsed_ms(rehash_start);
+    if (migrated.occupied_rows != migration.occupied_rows ||
+        migrated.survivor_rows != migration.survivor_rows || migrated.evicted_rows != migration.evicted_rows)
+      throw std::runtime_error("Native factor2 migration disagrees with quiescent preflight");
+    if (sets < before_sets) {
+      const auto mapping_start = std::chrono::steady_clock::now();
+      vmm_storage_->resize_values(sets * ways * row);
+      mapping_ms += nvemb_elapsed_ms(mapping_start);
+    }
+    receipt["vmm_mapping_ms"] = mapping_ms;
+    config_.cache_size = sets * per_set;
+    ++resize_generation_;
+    resize_poisoned_ = false;
+    receipt["status"] = "applied";
+    receipt["after"] = nlohmann::json::parse(cache_resize_state());
+    return receipt.dump();
+  }
+  const auto preflight_start = std::chrono::steady_clock::now();
+  Raw old = source->export_raw_state(true, host_limit);
+  PreservingRehash<Raw> plan;
+  try {
+    plan = plan_preserving_rehash(old, sets, host_limit, bool(policy_observation_));
+  } catch (const std::invalid_argument& error) {
+    return reject(error.what());
+  }
+  Raw target = std::move(plan.target);
+  receipt["survivor_rows"] = plan.survivor_rows;
+  receipt["evicted_rows"] = plan.evicted_rows;
+  receipt["host_staging_peak_bound_bytes"] = plan.host_peak_bound;
+  receipt["native_preflight_ms"] = nvemb_elapsed_ms(preflight_start);
+  receipt["status"] = "planned";
+  if (dry_run) return receipt.dump();
+
+  typename DeviceCache::CacheConfig cfg;
+  cfg.cache_sz_in_bytes = sets * per_set; cfg.embed_width_in_bytes = row;
+  cfg.num_tables = 1; cfg.allocate_data_on_host = false;
+  cfg.decay_rate = old.decay_rate; cfg.sentinel_key = old.sentinel;
+  cfg.vmm_storage = vmm_storage_;
+  cfg.policy_observation = policy_observation_;
+  cfg.vmm_active_sets = vmm_storage_ ? sets : 0;
+  // Constructing the wrapper allocates no GPU pool. All rejection paths above
+  // leave the source resident values, counters and pending insert state intact.
+  auto candidate = std::make_shared<DeviceCache>(allocator_.get(), GetGlobalLogger(), cfg);
+  CacheAllocationSize allocation{};
+  NVE_CHECK_(candidate->calc_allocation_size(allocation));
+  if (candidate->raw_num_sets_for_config() != sets ||
+      (!vmm_storage_ && allocation.device_allocation_size + (policy_observation_ ? policy_observation_->bytes() : 0) != target_pool))
+    return reject("native_geometry_mismatch");
+  old = Raw{};
+  resize_poisoned_ = true;
+  // Release both references: there are no execution contexts after preflight.
+  source->release_raw_pool_checked(true);
+  cache_.reset(); source.reset();
+  if (vmm_storage_) {
+    const auto mapping_start = std::chrono::steady_clock::now();
+    vmm_storage_->resize_values(sets * ways * row);
+    receipt["vmm_mapping_ms"] = nvemb_elapsed_ms(mapping_start);
+  }
+  // Failure after this point is intentionally not reported as HOLD/rollback.
+  // The GpuTable and hierarchy survive but refuse new execution contexts.
+  NVE_CHECK_(candidate->init());
+  candidate->restore_raw_state(target, true, host_limit);
+  auto checked = candidate->export_raw_state(true, host_limit);
+  if (checked.tags != target.tags || checked.data != target.data ||
+      checked.set_timestamps != target.set_timestamps || checked.global_ts != target.global_ts ||
+      checked.counters.size() != target.counters.size() ||
+      std::memcmp(checked.counters.data(), target.counters.data(), target.counters.size() * sizeof(float)) != 0)
+    throw std::runtime_error("Native restored state differs from preserving resize plan");
+  if (policy_observation_) policy_observation_->append_capacity(plan.evicted_keys, target.global_ts);
+  cache_ = candidate;
+  config_.cache_size = sets * per_set;
+  ++resize_generation_;
+  resize_poisoned_ = false;
+  receipt["status"] = "applied";
+  receipt["after"] = nlohmann::json::parse(cache_resize_state());
+  return receipt.dump();
+  }
 }
 

diff --git a/include/ecache/ec_vmm_rehash.cuh b/include/ecache/ec_vmm_rehash.cuh
new file mode 100644
--- /dev/null
+++ b/include/ecache/ec_vmm_rehash.cuh
@@ -0,0 +1,220 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "ec_vmm_rehash_common.hpp"
+#include "ec_policy_observation.hpp"
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <string>
+
+namespace nve {
+namespace vmm_rehash_detail {
+constexpr unsigned kThreads = 256;
+struct DeviceResult {
+  unsigned long long occupied;
+  unsigned long long survivors;
+  unsigned long long evicted;
+  unsigned errors;
+};
+static_assert(sizeof(DeviceResult) <= 64, "Storage owner reserves 64 bytes");
+
+inline void checked(cudaError_t error, const char* operation) {
+  if (error != cudaSuccess)
+    throw std::runtime_error(std::string(operation) + ": " + cudaGetErrorString(error));
+}
+
+// Read-only validation of all active metadata. No payload or policy state is
+// changed, including on mixed-age rejection. Only fixed scratch is written.
+template <int = 0>
+__global__ void preflight_kernel(const int64_t* tags, const float* counters,
+    const int64_t* timestamps, uint64_t old_sets, uint64_t new_sets,
+    int64_t global_ts, uint64_t groups, DeviceResult* result) {
+  const uint64_t group = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (group >= groups) return;
+  const bool shrink = new_sets < old_sets;
+  const unsigned sources = shrink ? 2 : 1;
+  unsigned count = 0, errors = 0;
+  int64_t resident_age = -1;
+  for (unsigned source = 0; source < sources; ++source) {
+    const uint64_t set = group + source * new_sets;
+    const int64_t age = timestamps[set];
+    if (age < 0 || age > global_ts) errors |= 1;
+    for (unsigned way = 0; way < 8; ++way) {
+      const uint64_t slot = set * 8 + way;
+      const int64_t tag = tags[slot];
+      const uint32_t score_bits = reinterpret_cast<const uint32_t*>(counters)[slot];
+      if (!vmm_rehash_valid_counter(score_bits)) errors |= 1;
+      if (tag == -1) continue;
+      ++count;
+      if (tag < 0 || uint64_t(tag) > (uint64_t(INT64_MAX) - set) / old_sets)
+        errors |= 1;
+      for (unsigned prior = 0; prior < way; ++prior)
+        if (tags[set * 8 + prior] == tag) errors |= 1;
+      if (resident_age < 0) resident_age = age;
+      if (shrink && age != resident_age) errors |= 2;
+    }
+  }
+  const unsigned retained = shrink && count > 8 ? 8 : count;
+  atomicAdd(&result->occupied, static_cast<unsigned long long>(count));
+  atomicAdd(&result->survivors, static_cast<unsigned long long>(retained));
+  atomicAdd(&result->evicted, static_cast<unsigned long long>(count - retained));
+  if (errors) atomicOr(&result->errors, errors);
+}
+
+// One CTA owns each source bucket (grow) or source pair (shrink). Target bucket
+// pairs are disjoint. Every source column tile is read before any destination
+// is written, so overlapping source/destination rows are safe in place.
+template <int = 0>
+__global__ void migrate_kernel(uint32_t* values, int64_t* tags, uint32_t* counter_bits,
+    int64_t* timestamps, uint64_t row_words, uint64_t old_sets,
+    uint64_t new_sets, unsigned tile_words, PolicyEventHeader* event_header,
+    PolicyEvictionEvent* events, uint64_t event_capacity, int64_t global_ts) {
+  const uint64_t group = blockIdx.x;
+  const bool shrink = new_sets < old_sets;
+  const unsigned sources = shrink ? 16 : 8;
+  __shared__ int64_t source_tags[16];
+  __shared__ uint64_t source_keys[16];
+  __shared__ uint32_t source_counters[16];
+  __shared__ int source_for_destination[16];
+  __shared__ unsigned counts[2];
+  __shared__ int64_t source_ages[2];
+  extern __shared__ uint32_t tile[];
+  if (threadIdx.x == 0) {
+    counts[0] = counts[1] = 0;
+    source_ages[0] = timestamps[group];
+    source_ages[1] = shrink ? timestamps[group + new_sets] : source_ages[0];
+    for (unsigned d = 0; d < 16; ++d) source_for_destination[d] = -1;
+    for (unsigned source = 0; source < sources; ++source) {
+      const uint64_t source_set = group + (source >= 8 ? new_sets : 0);
+      const uint64_t slot = source_set * 8 + source % 8;
+      source_tags[source] = tags[slot];
+      source_counters[source] = counter_bits[slot];
+      if (source_tags[source] == -1) continue;
+      source_keys[source] = uint64_t(source_tags[source]) * old_sets + source_set;
+      const unsigned side = shrink ? 0 : unsigned(source_tags[source] & 1);
+      const unsigned offset = side * 8;
+      // Shrink may have 16 candidates; only retain the best 8, matching the
+      // host raw planner's counter-descending/key-ascending selection.
+      unsigned position = counts[side];
+      if (position > 8) position = 8;
+      while (position > 0) {
+        const int previous = source_for_destination[offset + position - 1];
+        if (!vmm_rehash_better_bits(source_counters[source], source_keys[source],
+                                   source_counters[previous], source_keys[previous])) break;
+        if (position < 8)
+          source_for_destination[offset + position] = previous;
+        --position;
+      }
+      if (position < 8) source_for_destination[offset + position] = source;
+      if (counts[side] < 8) ++counts[side];
+    }
+    if (event_header && shrink) {
+      for (unsigned source = 0; source < sources; ++source) {
+        if (source_tags[source] == -1) continue;
+        bool retained = false;
+        for (unsigned destination = 0; destination < 8; ++destination)
+          if (source_for_destination[destination] == int(source)) retained = true;
+        if (!retained) {
+          const auto position = atomicAdd(&event_header->total, 1ULL);
+          atomicAdd(&event_header->capacity, 1ULL);
+          if (position < event_capacity) events[position] = {int64_t(source_keys[source]), global_ts, 1};
+        }
+      }
+    }
+  }
+  __syncthreads();
+  const unsigned destinations = shrink ? 8 : 16;
+  for (uint64_t first = 0; first < row_words; first += tile_words) {
+    const unsigned width = unsigned(row_words - first < tile_words ? row_words - first : tile_words);
+    for (unsigned item = threadIdx.x; item < sources * width; item += blockDim.x) {
+      const unsigned source = item / width, column = item % width;
+      if (source_tags[source] != -1) {
+        const uint64_t source_set = group + (source >= 8 ? new_sets : 0);
+        const uint64_t slot = source_set * 8 + source % 8;
+        tile[source * tile_words + column] = values[slot * row_words + first + column];
+      }
+    }
+    __syncthreads();
+    for (unsigned item = threadIdx.x; item < destinations * width; item += blockDim.x) {
+      const unsigned destination = item / width, column = item % width;
+      const int source = source_for_destination[destination];
+      if (source >= 0) {
+        const uint64_t destination_set = group + (destination >= 8 ? old_sets : 0);
+        const uint64_t slot = destination_set * 8 + destination % 8;
+        values[slot * row_words + first + column] = tile[source * tile_words + column];
+      }
+    }
+    __syncthreads();
+  }
+  if (threadIdx.x == 0) {
+    for (unsigned destination = 0; destination < destinations; ++destination) {
+      const int source = source_for_destination[destination];
+      const uint64_t destination_set = group + (destination >= 8 ? old_sets : 0);
+      const uint64_t slot = destination_set * 8 + destination % 8;
+      tags[slot] = source < 0 ? -1 : int64_t(source_keys[source] / new_sets);
+      counter_bits[slot] = source < 0 ? 0 : source_counters[source];
+    }
+    const int first = source_for_destination[0];
+    timestamps[group] = first < 0 ? 0 : source_ages[first >= 8 ? 1 : 0];
+    if (shrink) {
+      for (unsigned way = 0; way < 8; ++way) {
+        tags[(group + new_sets) * 8 + way] = -1;
+        counter_bits[(group + new_sets) * 8 + way] = 0;
+      }
+      timestamps[group + new_sets] = 0;
+    } else {
+      timestamps[group + old_sets] = counts[1] ? source_ages[0] : 0;
+    }
+  }
+}
+}  // namespace vmm_rehash_detail
+
+inline VmmRehashResult vmm_factor2_preflight(const int64_t* tags, const float* counters,
+    const int64_t* timestamps, uint64_t old_sets, uint64_t new_sets,
+    int64_t global_ts, void* fixed_scratch) {
+  using namespace vmm_rehash_detail;
+  const int direction = vmm_rehash_direction(old_sets, new_sets);
+  if (!tags || !counters || !timestamps || !fixed_scratch || global_ts < 0)
+    throw std::invalid_argument("invalid_vmm_rehash_metadata");
+  const uint64_t groups = direction < 0 ? new_sets : old_sets;
+  auto* device = static_cast<DeviceResult*>(fixed_scratch);
+  checked(cudaDeviceSynchronize(), "preflight drain");
+  checked(cudaMemset(device, 0, sizeof(DeviceResult)), "preflight clear scratch");
+  preflight_kernel<><<<unsigned((groups + kThreads - 1) / kThreads), kThreads>>>(
+      tags, counters, timestamps, old_sets, new_sets, global_ts, groups, device);
+  checked(cudaGetLastError(), "preflight launch");
+  DeviceResult host{};
+  checked(cudaMemcpy(&host, device, sizeof(host), cudaMemcpyDeviceToHost), "preflight result");
+  if (host.errors & 1) throw std::invalid_argument("invalid_resident_metadata");
+  if (host.errors & 2) throw std::invalid_argument("mixed_age_merge");
+  return {host.occupied, host.survivors, host.evicted};
+}
+
+// Call only after a successful preflight under the same exclusive barrier.
+// Growth destination backing must already exist; shrink tail must stay mapped.
+inline void vmm_factor2_migrate(int8_t* values, int64_t* tags, float* counters,
+    int64_t* timestamps, uint64_t row_bytes, uint64_t old_sets, uint64_t new_sets,
+    NvEmbPolicyObservation* observation = nullptr, int64_t global_ts = 0) {
+  using namespace vmm_rehash_detail;
+  const int direction = vmm_rehash_direction(old_sets, new_sets);
+  if (!direction) return;
+  if (!values || !tags || !counters || !timestamps || !row_bytes || row_bytes % 16)
+    throw std::invalid_argument("invalid_vmm_rehash_geometry");
+  const uint64_t groups = direction < 0 ? new_sets : old_sets;
+  if (groups > uint64_t(INT32_MAX)) throw std::invalid_argument("unsupported_set_count");
+  int device = 0, shared_limit = 0;
+  checked(cudaGetDevice(&device), "get rehash device");
+  checked(cudaDeviceGetAttribute(&shared_limit, cudaDevAttrMaxSharedMemoryPerBlock, device), "rehash shared limit");
+  if (shared_limit < 2048) throw std::invalid_argument("insufficient_rehash_shared_memory");
+  const unsigned tile_words = unsigned(std::min<uint64_t>(row_bytes / 4,
+      std::min<uint64_t>(512, uint64_t(shared_limit - 1024) / (16 * sizeof(uint32_t)))));
+  migrate_kernel<><<<unsigned(groups), kThreads, 16 * size_t(tile_words) * sizeof(uint32_t)>>>(
+      reinterpret_cast<uint32_t*>(values), tags, reinterpret_cast<uint32_t*>(counters),
+      timestamps, row_bytes / 4, old_sets, new_sets, tile_words,
+      observation ? observation->header() : nullptr, observation ? observation->events() : nullptr,
+      observation ? observation->capacity() : 0, global_ts);
+  checked(cudaGetLastError(), "rehash migration launch");
+  checked(cudaDeviceSynchronize(), "rehash migration completion");
+}
+}  // namespace nve

@@ -0,0 +1,249 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES.
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <cuda.h>
+#include <cuda_runtime_api.h>
+#include <allocator.hpp>
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace nve {
+
+// Storage only: all hash, LFU, admission, lookup and modification behavior is
+// provided by the existing CacheSADeviceModify. Cache generations borrow these
+// allocations; the final shared owner alone releases them. Values have one
+// stable reservation, and metadata is allocated for the maximum geometry.
+class NvEmbVmmStorage {
+ public:
+  NvEmbVmmStorage(std::shared_ptr<Allocator> allocator, int device, size_t row_bytes,
+                  size_t maximum_payload_bytes, size_t chunk_bytes)
+      : allocator_(std::move(allocator)), device_(device), row_bytes_(row_bytes),
+        chunk_bytes_(chunk_bytes), reserved_bytes_(maximum_payload_bytes) {
+    if (!allocator_ || !row_bytes || row_bytes % 16 || !chunk_bytes ||
+        row_bytes > std::numeric_limits<size_t>::max() / 8 ||
+        maximum_payload_bytes == 0 || maximum_payload_bytes % (8 * row_bytes) ||
+        maximum_payload_bytes % chunk_bytes)
+      throw std::invalid_argument("NVEmb VMM needs aligned positive row, maximum payload and chunk sizes");
+    max_sets_ = maximum_payload_bytes / (8 * row_bytes);
+    if (!max_sets_ || max_sets_ > UINT32_MAX)
+      throw std::invalid_argument("NVEmb VMM maximum set count is outside uint32");
+    const size_t tags = multiply(max_sets_, 8 * sizeof(int64_t));
+    const size_t counters = multiply(max_sets_, 8 * sizeof(float));
+    const size_t ages = multiply(max_sets_, sizeof(int64_t));
+    if (tags > std::numeric_limits<size_t>::max() - counters - ages - 79)
+      throw std::invalid_argument("NVEmb VMM metadata byte count overflow");
+    counter_offset_ = tags;
+    age_offset_ = tags + counters;
+    scratch_offset_ = ((tags + counters + ages + 15) / 16) * 16;
+    fixed_device_bytes_ = scratch_offset_ + 64;
+    fixed_host_bytes_ = tags;
+    try {
+      int current_device = -1;
+      runtime(cudaGetDevice(&current_device), "cudaGetDevice");
+      if (current_device != device_) throw std::invalid_argument("NVEmb VMM device mismatch at construction");
+      runtime(allocator_->device_allocate(reinterpret_cast<void**>(&metadata_), fixed_device_bytes_),
+              "NVEmb VMM metadata allocation");
+      runtime(allocator_->host_allocate(reinterpret_cast<void**>(&host_tags_), fixed_host_bytes_),
+              "NVEmb VMM host tags allocation");
+      runtime(cudaMemset(metadata_, 0, fixed_device_bytes_), "NVEmb VMM metadata initialization");
+      runtime(cudaDeviceSynchronize(), "NVEmb VMM metadata synchronization");
+      driver(cuCtxGetCurrent(&context_), "cuCtxGetCurrent");
+      if (!context_) throw std::runtime_error("NVEmb VMM requires an active CUDA context");
+      CUmemAllocationProp property{};
+      property.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+      property.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+      property.location.id = device_;
+      driver(cuMemGetAllocationGranularity(&granularity_, &property, CU_MEM_ALLOC_GRANULARITY_MINIMUM),
+             "cuMemGetAllocationGranularity");
+      if (chunk_bytes_ % granularity_ || chunk_bytes_ < granularity_)
+        throw std::invalid_argument("NVEmb VMM chunk size is not a multiple of device minimum granularity");
+      chunks_.reserve(reserved_bytes_ / chunk_bytes_);
+      driver(cuMemAddressReserve(&base_, reserved_bytes_, 0, 0, 0), "cuMemAddressReserve");
+    } catch (...) {
+      cleanup_noexcept();
+      throw;
+    }
+  }
+
+  NvEmbVmmStorage(const NvEmbVmmStorage&) = delete;
+  NvEmbVmmStorage& operator=(const NvEmbVmmStorage&) = delete;
+  ~NvEmbVmmStorage() { cleanup_noexcept(); }
+
+  int8_t* values() const { return reinterpret_cast<int8_t*>(base_); }
+  int64_t* tags() const { return reinterpret_cast<int64_t*>(metadata_); }
+  float* counters() const { return reinterpret_cast<float*>(metadata_ + counter_offset_); }
+  int64_t* timestamps() const { return reinterpret_cast<int64_t*>(metadata_ + age_offset_); }
+  int64_t* host_tags() const { return host_tags_; }
+  void* rehash_scratch() const { return metadata_ + scratch_offset_; }
+  uint64_t max_sets() const { return max_sets_; }
+  size_t row_bytes() const { return row_bytes_; }
+  size_t mapped_bytes() const { return mapped_bytes_; }
+  size_t allocated_bytes() const { return allocated_bytes_; }
+  size_t reserved_bytes() const { return reserved_bytes_; }
+  size_t fixed_device_bytes() const { return fixed_device_bytes_; }
+  size_t fixed_host_bytes() const { return fixed_host_bytes_; }
+  size_t chunk_bytes() const { return chunk_bytes_; }
+  size_t granularity() const { return granularity_; }
+  bool poisoned() const { return poisoned_; }
+  void validate_context() const { check_context(); }
+
+  size_t mapped_bytes_for_payload(size_t payload_bytes) const {
+    if (!payload_bytes || payload_bytes > reserved_bytes_)
+      throw std::invalid_argument("NVEmb VMM payload exceeds its reservation");
+    const size_t chunks = payload_bytes / chunk_bytes_ + bool(payload_bytes % chunk_bytes_);
+    return multiply(chunks, chunk_bytes_);
+  }
+
+  // Exclusive batch barrier only. Grow maps before publication; shrink
+  // is called only after migration made the tail inaccessible. Failures after
+  // any storage mutation poison the owner; no rollback is claimed.
+  void resize_values(size_t payload_bytes) {
+    if (poisoned_) throw std::runtime_error("NVEmb VMM storage is poisoned");
+    const size_t target = mapped_bytes_for_payload(payload_bytes);
+    check_context();
+    if (target == mapped_bytes_) return;
+    try {
+      while (mapped_bytes_ < target) {
+        Chunk chunk{};
+        chunk.address = base_ + mapped_bytes_;
+        CUmemAllocationProp property{};
+        property.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+        property.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        property.location.id = device_;
+        driver(cuMemCreate(&chunk.handle, chunk_bytes_, &property, 0), "cuMemCreate");
+        chunk.created = true;
+        chunks_.push_back(chunk);  // Capacity was reserved before any mappings.
+        allocated_bytes_ += chunk_bytes_;
+        auto& owned = chunks_.back();
+        const CUresult mapped = cuMemMap(owned.address, chunk_bytes_, 0, owned.handle, 0);
+        if (mapped != CUDA_SUCCESS) owned.quarantined = true;
+        driver(mapped, "cuMemMap");
+        owned.mapped = true;
+        mapped_bytes_ += chunk_bytes_;
+        CUmemAccessDesc access{};
+        access.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+        access.location.id = device_;
+        access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+        driver(cuMemSetAccess(owned.address, chunk_bytes_, &access, 1), "cuMemSetAccess");
+        // Invalid value bytes are intentionally untouched, just like the
+        // original NVEmb allocation. Native tags guard all value accesses.
+      }
+      while (mapped_bytes_ > target) {
+        auto& owned = chunks_.back();
+        const CUresult unmapped = cuMemUnmap(owned.address, chunk_bytes_);
+        if (unmapped != CUDA_SUCCESS) owned.quarantined = true;
+        driver(unmapped, "cuMemUnmap");
+        owned.mapped = false;
+        mapped_bytes_ -= chunk_bytes_;
+        const CUresult released = cuMemRelease(owned.handle);
+        if (released != CUDA_SUCCESS) owned.quarantined = true;
+        driver(released, "cuMemRelease");
+        owned.created = false;
+        allocated_bytes_ -= chunk_bytes_;
+        chunks_.pop_back();
+      }
+      // Mapping/access calls complete before return. The caller has already
+      // drained native work; no value initialization or extra device barrier
+      // is needed here. Shrink's migration must have completed before entry.
+    } catch (...) {
+      poisoned_ = true;
+      throw;
+    }
+  }
+
+ private:
+  struct Chunk {
+    CUdeviceptr address = 0;
+    CUmemGenericAllocationHandle handle = 0;
+    bool created = false;
+    bool mapped = false;
+    bool quarantined = false;
+  };
+  static size_t multiply(size_t a, size_t b) {
+    if (b && a > std::numeric_limits<size_t>::max() / b)
+      throw std::invalid_argument("NVEmb VMM size overflow");
+    return a * b;
+  }
+  static void runtime(cudaError_t error, const char* operation) {
+    if (error != cudaSuccess)
+      throw std::runtime_error(std::string(operation) + ": " + cudaGetErrorString(error));
+  }
+  static void driver(CUresult error, const char* operation) {
+    if (error != CUDA_SUCCESS)
+      throw std::runtime_error(std::string(operation) + " failed with CUDA driver code " + std::to_string(int(error)));
+  }
+  void check_context() const {
+    CUcontext current = nullptr;
+    driver(cuCtxGetCurrent(&current), "cuCtxGetCurrent");
+    if (current != context_)
+      throw std::invalid_argument("NVEmb VMM operation changed the owning CUDA context");
+  }
+  void cleanup_noexcept() noexcept {
+    // Never retry a failed unmap/free. CUDA failures can make completion
+    // ambiguous; preserve the reservation when any mapping is quarantined.
+    bool quarantine = false;
+    if (context_) {
+      CUcontext current = nullptr;
+      if (cuCtxGetCurrent(&current) != CUDA_SUCCESS || current != context_) {
+        std::fprintf(stderr, "NVEmb VMM cleanup quarantined: owner context is not current\n");
+        return;
+      }
+      if (cuCtxSynchronize() != CUDA_SUCCESS) {
+        std::fprintf(stderr, "NVEmb VMM cleanup quarantined: context synchronization failed\n");
+        return;
+      }
+    }
+    for (auto i = chunks_.rbegin(); i != chunks_.rend(); ++i) {
+      if (i->quarantined) { quarantine = true; continue; }
+      if (i->mapped) {
+        if (cuMemUnmap(i->address, chunk_bytes_) != CUDA_SUCCESS) {
+          quarantine = true; i->quarantined = true; continue;
+        }
+        i->mapped = false;
+      }
+      if (i->created) {
+        if (cuMemRelease(i->handle) != CUDA_SUCCESS) {
+          quarantine = true; i->quarantined = true; continue;
+        }
+        i->created = false;
+      }
+    }
+    if (base_ && !quarantine) {
+      if (cuMemAddressFree(base_, reserved_bytes_) != CUDA_SUCCESS)
+        std::fprintf(stderr, "NVEmb VMM reservation release failed; address quarantined\n");
+      base_ = 0;
+    }
+    if (metadata_) {
+      auto* pointer = metadata_; metadata_ = nullptr;
+      if (allocator_->device_free(pointer) != cudaSuccess)
+        std::fprintf(stderr, "NVEmb VMM metadata free failed; allocation quarantined\n");
+    }
+    if (host_tags_) {
+      auto* pointer = host_tags_; host_tags_ = nullptr;
+      if (allocator_->host_free(pointer) != cudaSuccess)
+        std::fprintf(stderr, "NVEmb VMM host-tag free failed; allocation quarantined\n");
+    }
+  }
+
+  std::shared_ptr<Allocator> allocator_;
+  int device_;
+  size_t row_bytes_, chunk_bytes_, reserved_bytes_;
+  uint64_t max_sets_ = 0;
+  size_t counter_offset_ = 0, age_offset_ = 0, scratch_offset_ = 0;
+  size_t fixed_device_bytes_ = 0, fixed_host_bytes_ = 0, granularity_ = 0;
+  size_t mapped_bytes_ = 0, allocated_bytes_ = 0;
+  CUcontext context_ = nullptr;
+  CUdeviceptr base_ = 0;
+  int8_t* metadata_ = nullptr;
+  int64_t* host_tags_ = nullptr;
+  bool poisoned_ = false;
+  std::vector<Chunk> chunks_;
+};
+}  // namespace nve

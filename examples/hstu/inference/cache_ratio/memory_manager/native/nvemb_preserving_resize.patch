+    static size_t raw_product(size_t a, size_t b)
+    {
+        if (b != 0 && a > std::numeric_limits<size_t>::max() / b)
+            throw std::invalid_argument("Raw state byte count overflow");
+        return a * b;
+    }
+
+    static void raw_charge(size_t& remaining, size_t bytes)
+    {
+        if (bytes > remaining) throw std::invalid_argument("Raw state exceeds host byte cap");
+        remaining -= bytes;
+    }

+  } else {
+  ScopedDevice scope(config_.device_id);
+  if (vmm_storage_) vmm_storage_->validate_context();
+  auto state = nlohmann::json::parse(cache_resize_state());
+  NVE_CHECK_(state.value("state", "poisoned") == "ready", "Policy observation requires a usable cache");
+  nlohmann::json result = {{"enabled", bool(policy_observation_)}, {"complete", false}, {"overflow", false},
+      {"resident_rows", nullptr}, {"capacity_rows", state.at("num_sets").template get<uint64_t>() * 8},
+      {"row_bytes", state.at("row_bytes")}, {"generation", resize_generation_},
+      {"admission_eviction_keys", nlohmann::json::array()}, {"admission_eviction_clocks", nlohmann::json::array()},
+      {"capacity_eviction_keys", nlohmann::json::array()}, {"capacity_eviction_clocks", nlohmann::json::array()},
+      {"admission_eviction_count", nullptr}, {"capacity_eviction_count", nullptr},
+      {"dropped_event_count", nullptr}, {"observation_device_bytes", policy_observation_ ? policy_observation_->bytes() : 0}};
+  if (!policy_observation_) return result.dump();
+  using DeviceCache = nve::CacheSADeviceModify<KeyType, KeyType>;
+  auto source = std::dynamic_pointer_cast<DeviceCache>(cache_);
+  const auto observed = source->policy_observation(reset);
+  const auto dropped = observed.header.total > policy_observation_->capacity() ? observed.header.total - policy_observation_->capacity() : 0;
+  result["overflow"] = dropped != 0; result["complete"] = dropped == 0;
+  result["dropped_event_count"] = dropped; result["resident_rows"] = observed.header.resident;
+  result["observation_serial"] = observed.serial; result["global_ts"] = source->raw_global_ts();
+  result["admission_eviction_count"] = observed.header.admission;
+  result["capacity_eviction_count"] = observed.header.capacity;
+  for (const auto& event : observed.events) {
+    result[event.kind ? "capacity_eviction_keys" : "admission_eviction_keys"].push_back(event.key);
+    result[event.kind ? "capacity_eviction_clocks" : "admission_eviction_clocks"].push_back(event.clock);
+  }
+  return result.dump();
+  }
+}

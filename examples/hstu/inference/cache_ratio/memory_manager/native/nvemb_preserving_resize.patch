@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <allocator.hpp>
+#include <cuda_runtime_api.h>
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+namespace nve {
+struct PolicyEventHeader {
+  unsigned long long total = 0, admission = 0, capacity = 0, resident = 0;
+};
+struct PolicyEvictionEvent { int64_t key, clock; uint64_t kind; };
+struct PolicyObservation {
+  PolicyEventHeader header;
+  std::vector<PolicyEvictionEvent> events;
+  uint64_t serial = 0;
+};
+
+// Shared by native cache views, including the legacy CPU migration path.
+// The bounded append log records dropped events through total > capacity.
+class NvEmbPolicyObservation {
+ public:
+  NvEmbPolicyObservation(std::shared_ptr<Allocator> allocator, size_t capacity)
+      : allocator_(std::move(allocator)), capacity_(capacity) {
+    if (!capacity || capacity > (1ULL << 26)) throw std::invalid_argument("Invalid policy event capacity");
+    bytes_ = sizeof(PolicyEventHeader) + capacity * sizeof(PolicyEvictionEvent);
+    checked(allocator_->device_allocate(&buffer_, bytes_));
+    try { checked(cudaMemset(buffer_, 0, sizeof(PolicyEventHeader))); }
+    catch (...) { allocator_->device_free(buffer_); buffer_ = nullptr; throw; }
+  }
+  ~NvEmbPolicyObservation() { if (buffer_) allocator_->device_free(buffer_); }
+  PolicyEventHeader* header() const { return static_cast<PolicyEventHeader*>(buffer_); }
+  PolicyEvictionEvent* events() const { return reinterpret_cast<PolicyEvictionEvent*>(header() + 1); }
+  size_t capacity() const { return capacity_; }
+  size_t bytes() const { return bytes_; }
+  PolicyObservation read(bool reset) {
+    PolicyObservation result;
+    checked(cudaMemcpy(&result.header, header(), sizeof(result.header), cudaMemcpyDeviceToHost));
+    result.events.resize(std::min<uint64_t>(result.header.total, capacity_));
+    if (!result.events.empty()) checked(cudaMemcpy(result.events.data(), events(),
+        result.events.size() * sizeof(PolicyEvictionEvent), cudaMemcpyDeviceToHost));
+    result.serial = serial_;
+    if (reset) { checked(cudaMemset(header(), 0, sizeof(PolicyEventHeader))); ++serial_; }
+    return result;
+  }
+  void append_capacity(const std::vector<int64_t>& keys, int64_t clock) {
+    if (keys.empty()) return;
+    PolicyEventHeader h;
+    checked(cudaMemcpy(&h, header(), sizeof(h), cudaMemcpyDeviceToHost));
+    const size_t count = h.total < capacity_ ? std::min<uint64_t>(keys.size(), capacity_ - h.total) : 0;
+    std::vector<PolicyEvictionEvent> copied(count);
+    for (size_t i = 0; i < count; ++i) copied[i] = {keys[i], clock, 1};
+    if (count) checked(cudaMemcpy(events() + h.total, copied.data(), count * sizeof(PolicyEvictionEvent), cudaMemcpyHostToDevice));
+    h.total += keys.size(); h.capacity += keys.size();
+    checked(cudaMemcpy(header(), &h, sizeof(h), cudaMemcpyHostToDevice));
+  }
+ private:
+  static void checked(cudaError_t status) { if (status != cudaSuccess) throw std::runtime_error(cudaGetErrorString(status)); }
+  std::shared_ptr<Allocator> allocator_;
+  void* buffer_ = nullptr;
+  size_t capacity_, bytes_;
+  uint64_t serial_ = 0;
+};
+}  // namespace nve

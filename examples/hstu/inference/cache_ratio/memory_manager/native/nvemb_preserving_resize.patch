+        for (size_t bytes : {RAW_FIXED_HOST_BYTES,
+                            raw_product(state.tags.capacity(), sizeof(TagT)),
+                            state.data.capacity(),
+                            raw_product(state.counters.capacity(), sizeof(CounterT)),
+                            raw_product(state.set_timestamps.capacity(), sizeof(int64_t))})
+            raw_charge(max_host_bytes, bytes);
+    }
+
+    static RawSizes validate_raw_state(const RawState& state, size_t max_host_bytes)
+    {
+        const auto sizes = raw_sizes(state, max_host_bytes);
+        if (state.tags.size() != sizes.slots || state.data.size() != sizes.data ||
+            state.counters.size() != sizes.slots || state.set_timestamps.size() != state.num_sets)
+            throw std::invalid_argument("Raw state vector sizes do not match geometry");
+        check_raw_host_capacity(state, max_host_bytes);
+        for (size_t set = 0; set < state.num_sets; ++set) {
+            if (state.set_timestamps[set] < 0 || state.set_timestamps[set] > state.global_ts)
+                throw std::invalid_argument("Raw set timestamp is outside the global clock");
+            for (size_t way = 0; way < NUM_WAYS; ++way) {
+                const size_t slot = set * NUM_WAYS + way;
+                if (!std::isfinite(state.counters[slot]) || state.counters[slot] < 0)
+                    throw std::invalid_argument("Raw counters must be finite and nonnegative");
+                const TagT tag = state.tags[slot];
+                if (tag == state.sentinel) continue;
+                if (tag < 0 || static_cast<uint64_t>(tag) >
+                    (static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) - set) / state.num_sets)
+                    throw std::invalid_argument("Raw tag does not reconstruct a nonnegative int64 key");
+                const IndexT key = static_cast<IndexT>(static_cast<uint64_t>(tag) * state.num_sets + set);
+                if (embed_cache_hash_set_idx(key, state.num_sets) != set ||
+                    embed_cache_construct_tag<TagT>(key, state.num_sets) != tag)
+                    throw std::invalid_argument("Raw key/tag mapping does not round trip");
+                // Distinct sets cannot reconstruct the same valid key. Within
+                // a set, identical tags are duplicates; no heap key set needed.
+                for (size_t prior = 0; prior < way; ++prior)
+                    if (state.tags[set * NUM_WAYS + prior] == tag)
+                        throw std::invalid_argument("Raw state contains duplicate resident keys");
+            }
+        }
+        return sizes;
+    }
+
+    void check_raw_scope() const
+    {
+        if (!raw_initialized_ || raw_restore_incomplete_ || !this->cache_ || !this->d_tags_ ||
+            !this->h_tags_ || !d_counters_ || !d_set_timestamps_ || this->config_.num_tables != 1 ||

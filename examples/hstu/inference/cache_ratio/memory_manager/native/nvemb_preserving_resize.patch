+++ b/include/nvemb_general_rehash.hpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+#include "ecache/ec_vmm_rehash_common.hpp"
+
+namespace nve {
+inline size_t general_product(size_t a, size_t b) {
+  if (b && a > std::numeric_limits<size_t>::max() / b) throw std::invalid_argument("general_geometry_overflow");
+  return a * b;
+}
+template<class Raw>
+size_t general_host_bound(size_t old_sets, size_t new_sets, size_t row) {
+  size_t total = 2 * sizeof(Raw) + (8 << 20);
+  const auto charge = [&](size_t value) {
+    if (value > std::numeric_limits<size_t>::max() - total) throw std::invalid_argument("general_staging_overflow");
+    total += value;
+  };
+  // Old/target values and metadata, old effective scores, ranking entries,
+  // worst-case eviction IDs and temporary event records, bounded readback.
+  charge(general_product(general_product(old_sets, 8), row + 8 + 4 + 8 + 4 + 32 + 8 + 24));
+  charge(general_product(general_product(new_sets, 8), row + 8 + 4 + 8));
+  charge(general_product(old_sets, 8)); charge(general_product(new_sets, 8));
+  return total;
+}
+template<class Raw> struct GeneralRehashPlan {
+  Raw target;
+  size_t occupied_rows = 0, survivor_rows = 0, host_peak_bound = 0;
+  std::vector<int64_t> evicted_keys;
+};
+
+// Effective scores are calculated read-only by CUDA with the same expression
+// as native lazy decay. Raw counters and row ages themselves never normalize.
+template<class Raw>
+GeneralRehashPlan<Raw> plan_general_rehash(const Raw& old, size_t sets, size_t host_limit) {
+  const auto require = [](bool ok, const char* reason) { if (!ok) throw std::invalid_argument(reason); };
+  require(sets && sets <= UINT32_MAX && old.num_sets && old.num_sets <= UINT32_MAX,
+          "unsupported_set_count");
+  require(old.ways == 8 && old.sentinel == -1 && old.row_bytes && old.row_bytes <= UINT32_MAX &&
+          old.row_bytes % 16 == 0 && old.global_ts >= 0, "unsupported_general_geometry");
+  const size_t bound = general_host_bound<Raw>(old.num_sets, sets, old.row_bytes);
+  require(bound <= host_limit, "host_staging_budget");
+  const size_t old_slots = general_product(old.num_sets, 8), slots = general_product(sets, 8);
+  require(old.tags.size() == old_slots && old.counters.size() == old_slots &&
+          old.row_timestamps.size() == old_slots && old.effective_scores.size() == old_slots &&
+          old.data.size() == general_product(old_slots, old.row_bytes), "invalid_general_shape");
+  struct Entry { uint64_t key; size_t source, destination; uint32_t score_bits; };
+  static_assert(sizeof(Entry) <= 32, "Host bound includes each ranking entry");
+  std::vector<Entry> entries; entries.reserve(old_slots);
+  for (size_t slot = 0; slot < old_slots; ++slot) {
+    if (old.tags[slot] == old.sentinel) continue;
+    const size_t source_set = slot / 8;
+    require(old.tags[slot] >= 0 && uint64_t(old.tags[slot]) <= (uint64_t(INT64_MAX) - source_set) / old.num_sets,
+            "invalid_general_key");
+    require(old.row_timestamps[slot] >= 0 && old.row_timestamps[slot] <= old.global_ts, "invalid_row_age");
+    uint32_t score, raw; std::memcpy(&score, &old.effective_scores[slot], 4); std::memcpy(&raw, &old.counters[slot], 4);
+    require(vmm_rehash_valid_counter(score) && vmm_rehash_valid_counter(raw), "invalid_general_counter");
+    for (size_t previous = source_set * 8; previous < slot; ++previous)
+      require(old.tags[previous] != old.tags[slot], "duplicate_key");
+    const uint64_t key = uint64_t(old.tags[slot]) * old.num_sets + source_set;
+    entries.push_back({key, slot, size_t(key % sets), score});
+  }
+  std::sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) {
+    return a.destination != b.destination ? a.destination < b.destination :
+      vmm_rehash_better_bits(a.score_bits, a.key, b.score_bits, b.key);
+  });
+  GeneralRehashPlan<Raw> plan;
+  plan.host_peak_bound = bound; plan.occupied_rows = entries.size(); plan.evicted_keys.reserve(old_slots);
+  auto& target = plan.target;
+  target.row_bytes = old.row_bytes; target.num_sets = sets; target.ways = 8;
+  target.sentinel = old.sentinel; target.decay_rate = old.decay_rate; target.global_ts = old.global_ts;
+  target.per_row_ages = true;
+  target.tags.assign(slots, -1); target.data.resize(general_product(slots, old.row_bytes));
+  target.counters.assign(slots, 0); target.row_timestamps.assign(slots, 0); target.set_timestamps.assign(sets, 0);
+  for (size_t first = 0; first < entries.size();) {
+    size_t end = first + 1;
+    while (end < entries.size() && entries[end].destination == entries[first].destination) ++end;
+    for (size_t i = first; i < end; ++i) {
+      const auto& entry = entries[i];
+      if (i - first >= 8) { plan.evicted_keys.push_back(int64_t(entry.key)); continue; }
+      const size_t slot = entry.destination * 8 + i - first;
+      target.tags[slot] = int64_t(entry.key / sets);
+      std::memcpy(&target.counters[slot], &old.counters[entry.source], sizeof(float));
+      target.row_timestamps[slot] = old.row_timestamps[entry.source];
+      target.set_timestamps[entry.destination] = old.global_ts;
+      std::copy_n(old.data.data() + entry.source * old.row_bytes, old.row_bytes,
+                  target.data.data() + slot * old.row_bytes);
+      ++plan.survivor_rows;
+    }
+    first = end;
+  }
+  return plan;
+}
+}  // namespace nve

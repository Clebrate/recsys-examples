+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "ec_policy_observation.hpp"
+#include <cuda_runtime.h>
+
+namespace nve {
+template<typename Counter, unsigned Ways>
+__global__ void age_represented_rows(const uint32_t* represented, uint32_t count,
+    Counter* counters, int64_t* row_ages, int64_t* set_ages, int64_t clock, float decay) {
+  const uint64_t i = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i >= uint64_t(count) * Ways) return;
+  const uint64_t set = represented[i / Ways], slot = set * Ways + i % Ways;
+  const int64_t delta = clock - row_ages[slot];
+  if (delta > 0 && decay != 1.0f) counters[slot] *= __powf(decay, static_cast<float>(delta));
+  row_ages[slot] = clock;
+  if (i % Ways == 0) set_ages[set] = clock;
+}
+
+template<int = 0>
+__global__ void effective_row_scores(const float* counters, const int64_t* row_ages,
+    uint64_t first, uint64_t count, int64_t clock, float decay, float* scores) {
+  const uint64_t i = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i >= count) return;
+  const int64_t delta = clock - row_ages[first + i];
+  float score = counters[first + i];
+  if (delta > 0 && decay != 1.0f) score *= __powf(decay, static_cast<float>(delta));
+  scores[i] = score;
+}
+
+template<typename Tag>
+__global__ void policy_count_resident(const Tag* tags, uint64_t slots, Tag sentinel,
+                                             PolicyEventHeader* header) {
+  // The caller launches 256 threads. Reduce the eight complete warps first;
+  // even lanes past the final slot participate with zero, including in the
+  // final partial block. Only one atomic per block reaches the shared counter.
+  __shared__ unsigned warp_sums[8];
+  const uint64_t i = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  unsigned count = i < slots && tags[i] != sentinel ? 1 : 0;
+  for (unsigned offset = 16; offset; offset >>= 1)
+    count += __shfl_down_sync(0xffffffffU, count, offset);
+  if (threadIdx.x % 32 == 0) warp_sums[threadIdx.x / 32] = count;
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    count = threadIdx.x < 8 ? warp_sums[threadIdx.x] : 0;
+    for (unsigned offset = 16; offset; offset >>= 1)
+      count += __shfl_down_sync(0xffffffffU, count, offset);
+    if (threadIdx.x == 0 && count) atomicAdd(&header->resident, static_cast<unsigned long long>(count));
+  }
+}
+
+template<typename List, typename Entry, typename Tag, unsigned Ways>
+__global__ void policy_record_replacements(const List* list, const Entry* entries,
+    uint32_t max_entries, const Tag* old_tags, uint64_t sets, Tag sentinel,
+    PolicyEventHeader* header, PolicyEvictionEvent* events, uint64_t capacity, int64_t clock) {
+  const uint64_t i = uint64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+  if (i >= list->num_entries || i >= max_entries) return;
+  const Entry entry = entries[i];
+  const Tag old = old_tags[uint64_t(entry.set) * Ways + entry.way];
+  if (old == sentinel || old == entry.tag) return;
+  const unsigned long long position = atomicAdd(&header->total, 1ULL);
+  atomicAdd(&header->admission, 1ULL);
+  if (position < capacity) events[position] = {int64_t(uint64_t(old) * sets + entry.set), clock, 0};
+}
+}  // namespace nve

+    static RawSizes raw_sizes(const RawState& state, size_t max_host_bytes)
+    {
+        static_assert(std::is_same<IndexT, int64_t>::value && std::is_same<TagT, int64_t>::value,
+                      "Experimental raw state supports int64 keys and tags only");
+        if (state.row_bytes == 0 || state.row_bytes > std::numeric_limits<uint32_t>::max() ||
+            state.row_bytes % 16 != 0 || state.num_sets == 0 ||
+            state.num_sets > std::numeric_limits<uint32_t>::max() || state.ways != NUM_WAYS ||
+            state.sentinel != static_cast<TagT>(-1) || !std::isfinite(state.decay_rate) ||
+            state.decay_rate < 0 || state.decay_rate > 1 || state.global_ts < 0)
+            throw std::invalid_argument("Unsupported raw state geometry, sentinel or clock");
+        RawSizes sizes;
+        sizes.slots = raw_product(static_cast<size_t>(state.num_sets), NUM_WAYS);
+        sizes.tags = raw_product(sizes.slots, sizeof(TagT));
+        sizes.data = raw_product(sizes.slots, state.row_bytes);
+        sizes.counters = raw_product(sizes.slots, sizeof(CounterT));
+        sizes.timestamps = raw_product(static_cast<size_t>(state.num_sets), sizeof(int64_t));
+        for (size_t bytes : {RAW_FIXED_HOST_BYTES, sizes.tags, sizes.data, sizes.counters, sizes.timestamps})
+            raw_charge(max_host_bytes, bytes);
+        return sizes;
+    }
